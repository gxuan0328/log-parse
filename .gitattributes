# ----------------------------------------------------------------------------
# log-parse — git attribute rules
# ----------------------------------------------------------------------------
# Default: text files use LF line endings on checkout, regardless of platform.
* text=auto eol=lf

# Shell scripts MUST be LF — bash on Windows still tolerates LF but breaks on CRLF.
*.sh    text eol=lf
Makefile text eol=lf

# Sample log fixtures are byte-exact and MUST NOT be line-ending-normalised,
# otherwise test baselines drift after a Windows checkout.
examples/sample-logs/** -text
examples/sample-outputs/** -text

# report-export baseline fixtures are byte-exact: source-log.csv keeps its
# CRLF (the verified input contract) and the .xlsx template is binary.
report-export/template/** -text

# report-export test fixtures are byte-exact too (CRLF CSV inputs + expected
# output snapshots) — the suite was validated against these exact bytes.
report-export/tests/fixtures/** -text

# report-export committed docker/example/ demo scenario (REQ4) is byte-exact
# too: the this-week input keeps its CRLF, and the seed state records.csv
# keeps its LF — otherwise the repo-wide `* text=auto eol=lf` default would
# normalise the CRLF input away on a Windows checkout.
report-export/docker/example/** -text

# Documentation
*.md       text eol=lf
*.zh-TW.md text eol=lf
